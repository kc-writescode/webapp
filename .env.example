# API Keys - Get your free keys from the following sources:
# Alpha Vantage: https://www.alphavantage.co/support/#api-key
# NewsAPI: https://newsapi.org/register

VITE_ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here
VITE_NEWS_API_KEY=your_news_api_key_here

# App Configuration
VITE_APP_NAME=FinLit Hub
VITE_APP_VERSION=2.0.0

# Cache Duration (milliseconds)
VITE_API_CACHE_DURATION=300000

# Feature Flags
VITE_ENABLE_CRYPTO=true
VITE_ENABLE_COMMUNITY=true
